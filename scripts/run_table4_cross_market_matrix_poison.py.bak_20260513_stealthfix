#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Tuple
import sys

import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from matrix_poison.agent import MatrixPoisonAgent, MatrixPoisonConfig
from matrix_poison.data import append_malicious_rows, build_user_item_sets, build_user_sequences, prepare_data
from matrix_poison.metrics import leave_one_out_hit_ndcg_at_k, prediction_shift

MODEL_ORDER = ["bpr", "neumf", "lightgcn", "sasrec"]
MODEL_LABEL = {
    "bpr": "BPR",
    "neumf": "NeuMF",
    "lightgcn": "LightGCN",
    "sasrec": "SASRec",
}
INTENT_LABEL = {
    "push": "Matrix Poison-Push",
    "nuke": "Matrix Poison-Nuke",
}
MARKETS = ["US", "JP", "UK"]


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Run Table-4 Matrix Poison (Push/Nuke) in cross-market setup.")
    p.add_argument("--xmarket-root", default="", help="Optional root with US/JP/UK subdirs containing interactions.csv and items.csv")
    p.add_argument("--ml1m-interactions", default="data/ml1m/interactions.csv")
    p.add_argument("--ml1m-items", default="data/ml1m/items.csv")
    p.add_argument("--pseudo-market-root", default="outputs/table4_baseline_seed42/generated_cross_market")
    p.add_argument("--baseline-csv", default="outputs/table4_baseline_seed42/table4_baseline_seed42.csv")
    p.add_argument("--output-dir", default="outputs/table4_nuke_push_seed42")
    p.add_argument("--models", default=",".join(MODEL_ORDER))
    p.add_argument("--intents", default="push,nuke")
    p.add_argument("--target-category", default="Action")
    p.add_argument("--target-item-policy", choices=["head", "median", "tail"], default="head")
    p.add_argument("--target-eval-size", type=int, default=1)
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--k", type=int, default=10)
    p.add_argument("--nuke-epsilon", type=float, default=0.02)
    p.add_argument("--push-epsilon", type=float, default=0.02)
    p.add_argument("--max-iters", type=int, default=5)
    p.add_argument("--clean-epochs", type=int, default=20)
    p.add_argument("--probe-epochs", type=int, default=4)
    p.add_argument("--judge-epochs", type=int, default=8)
    p.add_argument("--batch-size", type=int, default=8192)
    p.add_argument("--sasrec-batch-size", type=int, default=4096)
    p.add_argument("--embedding-dim", type=int, default=64)
    p.add_argument("--lightgcn-layers", type=int, default=2)
    p.add_argument("--sasrec-max-len", type=int, default=50)
    p.add_argument("--sasrec-recent-steps", type=int, default=0, help="SASRec one-step samples from recent transitions (<=0 means all).")
    p.add_argument("--lr", type=float, default=1e-3)
    p.add_argument("--weight-decay", type=float, default=1e-6)
    p.add_argument("--profile-max-len", type=int, default=120)
    p.add_argument("--push-profile-max-len", type=int, default=24)
    p.add_argument("--min-positive-rating", type=float, default=1.0)
    p.add_argument("--positive-threshold", type=float, default=1.0)
    p.add_argument("--push-use-explicit-neg", action="store_true")
    p.add_argument("--push-neg-sample-bias", type=float, default=0.0)
    p.add_argument("--nuke-neg-sample-bias", type=float, default=0.8)
    p.add_argument("--push-min-shift", type=float, default=1e-4)
    p.add_argument("--push-negative-penalty", type=float, default=3.0)
    p.add_argument("--push-target-shift", type=float, default=0.8)
    p.add_argument("--push-epsilon-max", type=float, default=0.5)
    p.add_argument("--disable-push-shift-unseen-only", action="store_true")
    p.add_argument("--enable-camel", action="store_true", help="Enable CAMEL orchestrator. Disabled by default for reproducibility.")
    p.add_argument("--final-eval-epochs", type=int, default=8, help="Epochs for final clean/poisoned retraining used in reported metrics.")
    p.add_argument("--final-eval-user-limit", type=int, default=0, help="Final reported evaluation users limit (<=0 means all test users).")
    p.add_argument("--device", default="auto")
    p.add_argument("--decimals", type=int, default=4)
    return p.parse_args()


def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def has_complete_markets(root: Path) -> bool:
    for m in MARKETS:
        if not ((root / m / "interactions.csv").exists() and (root / m / "items.csv").exists()):
            return False
    return True


def resolve_markets(args: argparse.Namespace) -> Tuple[Path, bool]:
    if args.xmarket_root:
        root = Path(args.xmarket_root).expanduser().resolve()
        if has_complete_markets(root):
            return root, False

    pseudo_root = (ROOT / args.pseudo_market_root).resolve()
    if has_complete_markets(pseudo_root):
        return pseudo_root, True

    ensure_dir(pseudo_root)
    inter = pd.read_csv((ROOT / args.ml1m_interactions).resolve())
    items = pd.read_csv((ROOT / args.ml1m_items).resolve())

    users = sorted(inter["user_id"].astype(str).unique().tolist())
    buckets = {"US": set(), "JP": set(), "UK": set()}
    for i, u in enumerate(users):
        if i % 3 == 0:
            buckets["US"].add(u)
        elif i % 3 == 1:
            buckets["JP"].add(u)
        else:
            buckets["UK"].add(u)

    for market, uids in buckets.items():
        mdir = pseudo_root / market
        ensure_dir(mdir)
        sub = inter[inter["user_id"].astype(str).isin(uids)].copy()
        sub.to_csv(mdir / "interactions.csv", index=False)
        items.to_csv(mdir / "items.csv", index=False)
    return pseudo_root, True


def resolve_category(data, preferred: str) -> str:
    if preferred in data.category_to_items and len(data.category_to_items[preferred]) > 0:
        return preferred
    for cat, items in sorted(data.category_to_items.items(), key=lambda kv: len(kv[1]), reverse=True):
        if str(cat).upper() in {"UNKNOWN", "OTHER"}:
            continue
        if len(items) > 0:
            return str(cat)
    return sorted(data.category_to_items.keys())[0]


def pick_target_item(data, target_category: str, policy: str) -> int:
    items = list(data.category_to_items[target_category])
    pop = data.train["item"].value_counts().to_dict()
    items = sorted(items, key=lambda i: pop.get(int(i), 0), reverse=True)
    if not items:
        raise ValueError(f"No items for target category: {target_category}")
    if policy == "tail":
        return int(items[-1])
    if policy == "median":
        return int(items[len(items) // 2])
    return int(items[0])


def fmt(v: float, decimals: int = 4) -> str:
    return f"{float(v):.{decimals}f}"


def fmt_or_keep(v: object, decimals: int = 4) -> str:
    if v is None:
        return "N/A"
    s = str(v).strip()
    if s in {"", "-", "N/A", "nan", "NaN"}:
        return "-" if s == "-" else "N/A"
    try:
        return fmt(float(s), decimals)
    except Exception:
        return s


def run_attack_for_case(
    interactions: Path,
    items: Path,
    model: str,
    intent: str,
    target_category: str,
    target_item_policy: str,
    args: argparse.Namespace,
) -> Dict[str, float | int | str]:
    data = prepare_data(
        interactions_path=str(interactions),
        items_path=str(items),
        min_positive_rating=float(args.min_positive_rating),
        seed=int(args.seed),
    )
    category = resolve_category(data, target_category)
    target_item = pick_target_item(data, category, target_item_policy)

    batch_size = int(args.sasrec_batch_size) if model == "sasrec" else int(args.batch_size)
    epsilon = float(args.push_epsilon) if intent == "push" else float(args.nuke_epsilon)
    cfg = MatrixPoisonConfig(
        intent=intent,
        model_name=model,
        epsilon=epsilon,
        max_iters=int(args.max_iters),
        clean_epochs=int(args.clean_epochs),
        probe_epochs=int(args.probe_epochs),
        judge_epochs=int(args.judge_epochs),
        batch_size=batch_size,
        embedding_dim=int(args.embedding_dim),
        lightgcn_layers=int(args.lightgcn_layers),
        sasrec_max_len=int(args.sasrec_max_len),
        sasrec_recent_steps=int(args.sasrec_recent_steps),
        lr=float(args.lr),
        weight_decay=float(args.weight_decay),
        k=int(args.k),
        target_eval_size=int(args.target_eval_size),
        profile_max_len=int(args.profile_max_len),
        push_profile_max_len=int(args.push_profile_max_len),
        positive_rating_threshold=float(args.positive_threshold),
        push_use_explicit_neg=bool(args.push_use_explicit_neg),
        push_neg_sample_bias=float(args.push_neg_sample_bias),
        nuke_neg_sample_bias=float(args.nuke_neg_sample_bias),
        push_min_shift=float(args.push_min_shift),
        push_negative_penalty=float(args.push_negative_penalty),
        push_shift_on_unseen_only=not bool(args.disable_push_shift_unseen_only),
        push_target_shift=float(args.push_target_shift),
        push_epsilon_max=float(args.push_epsilon_max),
        camel_enabled=bool(args.enable_camel),
        seed=int(args.seed),
        device=str(args.device),
    )
    agent = MatrixPoisonAgent(
        data=data,
        target_category=category,
        target_item=target_item,
        cfg=cfg,
    )
    result = agent.run()
    best = result.best_metrics or {}

    malicious_rows = result.malicious_rows if result.malicious_rows is not None else pd.DataFrame(columns=data.train.columns)
    poisoned_train = append_malicious_rows(data.train, malicious_rows)

    # Re-train clean/poisoned models and report metrics with the same corrected
    # leave-one-out protocol used by the baseline table.
    final_epochs = int(args.final_eval_epochs)
    clean_model = agent._train_model(data.train, epochs=final_epochs, seed_offset=9000)
    poison_model = agent._train_model(poisoned_train, epochs=final_epochs, seed_offset=9100)

    clean_seq = build_user_sequences(data.train, int(args.sasrec_max_len))
    poison_seq = build_user_sequences(poisoned_train, int(args.sasrec_max_len))

    poison_user_items = build_user_item_sets(poisoned_train)
    quality = leave_one_out_hit_ndcg_at_k(
        model=poison_model,
        test_df=data.test,
        train_user_items=poison_user_items,
        num_items=data.num_items,
        k=int(args.k),
        user_sequences=poison_seq,
        user_limit=int(args.final_eval_user_limit),
    )

    eval_users = sorted(set(data.test["user"].astype(int).tolist()))
    if intent == "push" and not bool(args.disable_push_shift_unseen_only):
        clean_user_items = build_user_item_sets(data.train)
        unseen_users = [u for u in eval_users if int(target_item) not in clean_user_items.get(int(u), set())]
        shift_users = unseen_users if unseen_users else eval_users
    else:
        shift_users = eval_users

    p_shift = prediction_shift(
        clean_model=clean_model,
        poisoned_model=poison_model,
        users=shift_users,
        target_item=int(target_item),
        clean_sequences=clean_seq,
        poisoned_sequences=poison_seq,
    )

    return {
        "hit": float(quality.get("hit", 0.0)),
        "ndcg": float(quality.get("ndcg", 0.0)),
        "prediction_shift": float(p_shift),
        "objective": float(best.get("objective", 0.0)),
        "best_reward": float(result.best_reward),
        "best_iteration": int(result.best_iteration),
        "best_epsilon": float(result.best_epsilon),
        "agent_best_hit": float(best.get("hit", 0.0)),
        "agent_best_ndcg": float(best.get("ndcg", 0.0)),
        "agent_best_prediction_shift": float(best.get("prediction_shift", 0.0)),
        "target_category": category,
        "target_item_index": int(target_item),
        "target_item_raw_id": data.index_to_item_id.get(int(target_item), "UNKNOWN"),
        "num_users": int(data.num_users),
        "num_items": int(data.num_items),
    }


def load_baseline_rows(path: Path) -> Dict[str, Dict[str, str]]:
    if not path.exists():
        return {}
    df = pd.read_csv(path)
    rows: Dict[str, Dict[str, str]] = {}
    for _, r in df.iterrows():
        model = str(r.get("Model", "")).strip()
        if not model:
            continue
        rows[model] = {c: str(r[c]) for c in df.columns}
    return rows


def build_latex_table(df: pd.DataFrame) -> str:
    lines: List[str] = []
    lines.append("\\begin{table*}[t]")
    lines.append("\\centering")
    lines.append("\\caption{Table 4 Cross-Market Baseline + Matrix Poison (Push/Nuke) Results (Seed=42).}")
    lines.append("\\label{tab:table4-cross-market-matrix-poison-seed42}")
    lines.append("\\begin{tabular}{llccccccccc}")
    lines.append("\\toprule")
    lines.append("Methods & Model & \\multicolumn{3}{c}{US} & \\multicolumn{3}{c}{JP} & \\multicolumn{3}{c}{UK} \\\\")
    lines.append("\\cmidrule(lr){3-5} \\cmidrule(lr){6-8} \\cmidrule(lr){9-11}")
    lines.append(" & & Hit@10 & NDCG@10 & P. Shift & Hit@10 & NDCG@10 & P. Shift & Hit@10 & NDCG@10 & P. Shift \\\\")
    lines.append("\\midrule")
    for _, r in df.iterrows():
        lines.append(
            f"{r['Methods']} & {r['Model']} & "
            f"{r['US Hit@10']} & {r['US NDCG@10']} & {r['US P. Shift']} & "
            f"{r['JP Hit@10']} & {r['JP NDCG@10']} & {r['JP P. Shift']} & "
            f"{r['UK Hit@10']} & {r['UK NDCG@10']} & {r['UK P. Shift']} \\\\"
        )
    lines.append("\\bottomrule")
    lines.append("\\end{tabular}")
    lines.append("\\end{table*}")
    return "\n".join(lines) + "\n"


def main() -> None:
    args = parse_args()
    out_dir = (ROOT / args.output_dir).resolve()
    ensure_dir(out_dir)

    baseline_csv = (ROOT / args.baseline_csv).resolve()
    baseline_by_model = load_baseline_rows(baseline_csv)

    market_root, used_pseudo = resolve_markets(args)
    models = [m.strip().lower() for m in args.models.split(",") if m.strip()]
    intents = [x.strip().lower() for x in args.intents.split(",") if x.strip()]
    intents = [x for x in intents if x in INTENT_LABEL]

    attack_results: Dict[Tuple[str, str, str], Dict[str, object]] = {}
    details: List[Dict[str, object]] = []
    for model in models:
        for intent in intents:
            for market in MARKETS:
                inter = market_root / market / "interactions.csv"
                items = market_root / market / "items.csv"
                result = run_attack_for_case(
                    interactions=inter,
                    items=items,
                    model=model,
                    intent=intent,
                    target_category=args.target_category,
                    target_item_policy=args.target_item_policy,
                    args=args,
                )
                attack_results[(market, model, intent)] = result
                details.append(
                    {
                        "market": market,
                        "model": model,
                        "intent": intent,
                        **result,
                    }
                )
                print(
                    f"[table4][{intent}][{market}][{model}] "
                    f"hit={float(result['hit']):.4f} ndcg={float(result['ndcg']):.4f} "
                    f"p_shift={float(result['prediction_shift']):.4f} "
                    f"target={result['target_item_raw_id']}",
                    flush=True,
                )

    rows: List[Dict[str, str]] = []
    for model in models:
        model_name = MODEL_LABEL.get(model, model)
        base = baseline_by_model.get(model_name, {})
        base_row: Dict[str, str] = {
            "Methods": "Baseline",
            "Model": model_name,
        }
        for market in MARKETS:
            base_row[f"{market} Hit@10"] = fmt_or_keep(base.get(f"{market} Hit@10", "N/A"), args.decimals)
            base_row[f"{market} NDCG@10"] = fmt_or_keep(base.get(f"{market} NDCG@10", "N/A"), args.decimals)
            base_row[f"{market} P. Shift"] = str(base.get(f"{market} P. Shift", "-"))
        rows.append(base_row)

        for intent in intents:
            row: Dict[str, str] = {
                "Methods": INTENT_LABEL[intent],
                "Model": model_name,
            }
            for market in MARKETS:
                r = attack_results.get((market, model, intent))
                if not r:
                    row[f"{market} Hit@10"] = "N/A"
                    row[f"{market} NDCG@10"] = "N/A"
                    row[f"{market} P. Shift"] = "N/A"
                    continue
                row[f"{market} Hit@10"] = fmt(float(r["hit"]), args.decimals)
                row[f"{market} NDCG@10"] = fmt(float(r["ndcg"]), args.decimals)
                row[f"{market} P. Shift"] = fmt(abs(float(r["prediction_shift"])), args.decimals)
            rows.append(row)

    table_df = pd.DataFrame(rows)
    table_csv = out_dir / "table4_with_matrix_poison_seed42.csv"
    table_df.to_csv(table_csv, index=False)

    detail_csv = out_dir / "table4_with_matrix_poison_seed42_details.csv"
    pd.DataFrame(details).to_csv(detail_csv, index=False)

    tex_path = out_dir / "table4_with_matrix_poison_seed42.tex"
    tex_path.write_text(build_latex_table(table_df), encoding="utf-8")

    md_path = out_dir / "table4_with_matrix_poison_seed42.md"
    md_lines = ["| " + " | ".join(table_df.columns.tolist()) + " |", "| " + " | ".join(["---"] * len(table_df.columns)) + " |"]
    for _, r in table_df.iterrows():
        md_lines.append("| " + " | ".join(str(r[c]) for c in table_df.columns) + " |")
    md_path.write_text("\n".join(md_lines) + "\n", encoding="utf-8")

    meta = {
        "generated_at": datetime.now().isoformat(timespec="seconds"),
        "seed": int(args.seed),
        "market_root": str(market_root),
        "used_pseudo_markets_from_ml1m": bool(used_pseudo),
        "baseline_csv": str(baseline_csv),
        "models": models,
        "intents": intents,
        "args": vars(args),
    }
    (out_dir / "table4_with_matrix_poison_seed42_meta.json").write_text(
        json.dumps(meta, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )

    print(f"[done] table csv: {table_csv}")
    print(f"[done] latex: {tex_path}")
    print(f"[done] details: {detail_csv}")


if __name__ == "__main__":
    main()
